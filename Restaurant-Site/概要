#タイトル
Luna Table｜自家製パスタと季節のイタリアン

##構造[HTML]
header/site-header
  h1 [Logo]
  nav/site-nav [Navigation]
    ul
      li*5>a #About,#Menu,#Gallery,#Access,#Reservation

main
  section/hero
    div/hero-content
      p/hero-label [Label]
      h2 [Title]
      p/hero-description [Description]
      a#reservation/button [Button]
  section/section/#about
    div/section-inner
      h2/section-title [Title]
      h3 [Heading]
      p [Text]
      p [Text]
  section/section/#menu
    div/section-inner
      h2/section-title [Title]
      div/menu-list
        article*6/menu-item [MenuItem]
          img
          h3
          p
          p
  section/section/#gallery
    div/section-inner
      h2/section-title [Title]
      div/gallery
        div/gallery-item*6 [GalleryItem]
          img
  section/section/#access
    div/section-inner
      h2/section-title [Title]
      div/access-content
        div/access-info [StoreInfo]
          address
          a
          dl
            dt
            dd
            dt
            dd
            dt
            dd
        div/access-map [Map]
          iframe
  section/section/reservation/#reservation
    div/section-inner
      h2/section-title [Title]
      p [Text]
      form/reservation-form
        div/form-group
          label [name]
          input/#name [text]
        div/form-group
          label [email]
          input/#email [email]
        div/form-group
          label [phone]
          input/#phone [tel]
        div/form-group
          label [date]
          input/#date [date]
        div/form-group
          label [time]
          input/#time [time]
        div/form-group
          label [guests]
          input/#guests [number]
        div/form-group
          label [message]
          textarea/#message [message]
        button/reservation-button [submit]

footer
  p [Copyright]
  p [Address]